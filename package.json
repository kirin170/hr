{
  "name": "talentflow-recruitment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "dev:web": "npm run dev",
    "dev:api": "npm --prefix backend run start:dev",
    "dev:worker": "npm --prefix backend run start:worker:dev",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix backend run build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "db:generate": "npm --prefix backend run db:generate",
    "db:validate": "npm --prefix backend run db:validate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:migrate": "npm --prefix backend run db:migrate:dev --",
    "db:migrate:deploy": "npm --prefix backend run db:migrate:deploy",
    "db:migrate:status": "npm --prefix backend run db:migrate:status",
    "db:setup": "npm run db:generate && npm run db:migrate:deploy && npm run db:seed"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}

