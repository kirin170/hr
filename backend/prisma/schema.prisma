generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Job {
  id             String   @id @default(cuid())
  code           String   @unique
  title          String
  departmentId   String
  location       String?
  recruiterId    String?
  requirements   String?  @db.Text
  headcount      Int      @default(0)
  hiredCount     Int      @default(0)
  status         JobStatus @default(ACTIVE)
  interviewPlanId String?
  sources        String?
  isVirtual      Boolean  @default(false)
  /// AI 评估职位级开关（AI-3 可关闭）；关闭后不再发起简历/面试评估
  aiEvalEnabled  Boolean  @default(true)
  requisitionId  String?  @unique
  requisition    JobRequisition? @relation(fields: [requisitionId], references: [id])
  candidates     Candidate[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([departmentId, status])
  @@index([recruiterId])
  @@map("jobs")
}

/// 招聘需求（HC）：OA 审批通过后生成，人事补充招聘要求与开始招聘时间；周期为需求级指标
model JobRequisition {
  id                   String   @id @default(cuid())
  oaApprovalId         String   @unique
  oaApprovalTitle      String?
  title                String
  departmentId         String
  recruiterId          String?
  jobLevel             String?
  /// 需求类型：取值来自字典 REQUISITION_TYPE；空值在报表中统计为“未填写”（ATS-023）
  requisitionType      String?
  headcount            Int
  source               String   @default("DINGTALK_OA")
  /// 钉钉审批编号（审批单上展示的 businessId）；oaApprovalId 保存审批实例 ID 作为幂等键
  oaBusinessId         String?
  status               RequisitionStatus @default(ACTIVE)
  /// 需求提报时间：由 OA 同步带出，只读，不参与周期计算
  submittedAt          DateTime
  /// 开始招聘时间：生成需求时必填，仅关闭前可改；存量已关闭需求可为空
  recruitmentStartDate DateTime? @map("recruitment_start_date")
  closedAt             DateTime?
  cycleDays            Int?
  /// 是否纳入周期统计；本期不补录的已关闭存量需求为 false
  cycleEligible        Boolean  @default(true)
  note                 String?  @db.Text
  requirements         String?  @db.Text
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  jobs                 Job[]

  @@index([status, closedAt])
  @@index([departmentId, status])
  @@index([recruiterId])
  @@index([requisitionType])
  @@map("job_requisitions")
}

enum JobStatus {
  ACTIVE
  CLOSED

  @@map("job_status")
}

enum RequisitionStatus {
  ACTIVE
  CLOSED

  @@map("requisition_status")
}

model Candidate {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  email           String?
  jobId           String?
  poolType        PoolType @default(NONE)
  stage           CandidateStage @default(UNASSIGNED)
  source          String?
  channel         String?
  /// 归档来源渠道（归档时快照，人才库按来源检索用；ATS-013）
  archiveChannel  String?
  entryMode       String?
  /// 来源平台候选人 ID（如 BOSS 的 encryptGeekId），用于按平台 ID 查重（ATS-010）
  sourcePlatformId String?
  browserImportTaskId String?
  intentId        String?
    tags            String?  @db.Text
  rating          Int?
  experience      String?
  education       String?
  school          String?
  currentCompany  String?
  currentTitle    String?
  summary         String?  @db.Text
  resumeName      String?
  workHistory     Json?
  note            String?  @db.Text
  archiveReasonId String?
  archiveReasonText String? @db.Text
  lockedState     LockedState @default(NONE)
  parsedProfileId String?
  appliedAt       DateTime?
  createdById     String?
  createdBy       User?    @relation("CandidateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  interviews      Interview[]
  departmentScreenings CandidateDepartmentScreening[]
  talentPoolEntries CandidateTalentPoolEntry[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             Job? @relation(fields: [jobId], references: [id])

  @@index([createdById])
  @@index([sourcePlatformId])
  /// 阶段/人才库 Tab 真实计数与万级列表排序（ATS-013）
  @@index([stage, updatedAt, createdAt])
  @@index([poolType, stage])
  @@index([archiveChannel, stage])

  @@map("candidates")
}

enum PoolType {
  NONE
  UNASSIGNED
  VIRTUAL

  @@map("pool_type")
}

enum CandidateStage {
  UNASSIGNED
  VIRTUAL_POOL
  RECOMMENDED
  HR_SCREENING
  DEPT_SCREENING
  INTERVIEWING
  OFFERING
  PENDING_ONBOARD
  ONBOARDED
  PROBATION
  ENDED
  ARCHIVED

  @@map("candidate_stage")
}

enum LockedState {
  NONE
  OPERABLE
  INOPERABLE

  @@map("locked_state")
}

enum DepartmentScreeningResult {
  PASS
  HOLD
  REJECT

  @@map("department_screening_result")
}

model CandidateDepartmentScreening {
  id                String   @id @default(cuid())
  candidateId       String
  reviewerId        String?
  result            DepartmentScreeningResult
  reason            String?  @db.Text
  availabilitySlots Json?
  revokedAt         DateTime?
  createdAt         DateTime @default(now())
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  reviewer          User? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([candidateId, result, revokedAt])
  @@index([reviewerId, candidateId])
  @@map("candidate_department_screenings")
}

model SavedCandidateFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, updatedAt])
  @@map("saved_candidate_filters")
}

model Interview {
  id              String   @id @default(cuid())
  candidateId     String
  jobId           String
  round           Int      @default(1)
  mode            InterviewMode
  time            DateTime
  endTime         DateTime?
  location        String?
  interviewerIds  String?
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status          InterviewStatus @default(TO_SCHEDULE)
  calendarEventId String?
  cancelReason    String?
  responses       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("interviews")
}

enum InterviewMode {
  ONSITE
  VIDEO
  PHONE

  @@map("interview_mode")
}

enum InterviewStatus {
  TO_SCHEDULE
  FEEDBACK_PENDING
  COMPLETED
  CANCELLED

  @@map("interview_status")
}

model InterviewFeedback {
  id              String   @id @default(cuid())
  interviewId     String
  interviewerId   String
  filledById      String
  filledByMode    String   @default("SELF")
  proxyName       String?
  proxyAt         DateTime?
  content         String   @db.Text
  conclusion      String?
  aiSuggestionRunId String?
  visibleToInterviewers Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("interview_feedback")
}

model InterviewChange {
  id          String   @id @default(cuid())
  interviewId String
  action      String
  actorId     String
  reason      String   @db.Text
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())
  @@index([interviewId, createdAt])
  @@map("interview_changes")
}

model InterviewMockNotification {
  id          String   @id @default(cuid())
  interviewId String
  action      String
  recipient   String
  createdAt   DateTime @default(now())
  @@index([interviewId, createdAt])
  @@map("interview_mock_notifications")
}

model InterviewRegistrationTemplate {
  id        String   @id @default(cuid())
  fields    Json
  createdBy String
  createdAt DateTime @default(now())
  @@map("interview_registration_templates")
}

model InterviewRegistrationForm {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  templateId  String
  fields      Json
  values      Json
  submittedBy String
  createdAt   DateTime @default(now())
  @@index([candidateId, jobId, createdAt])
  @@map("interview_registration_forms")
}

model InterviewRegistrationInvite {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  interviewId String
  templateId  String
  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   String
  createdAt   DateTime @default(now())
  @@index([interviewId])
  @@map("interview_registration_invites")
}

model InterviewTranscriptLink {
  id          String   @id @default(cuid())
  interviewId String
  candidateId String
  jobId       String
  round       Int
  url         String   @db.Text
  createdBy   String
  createdAt   DateTime @default(now())
  /// 链接来源：人工粘贴或钉钉听记地址；追加写入，不覆盖既有链接（ATS-020）
  source      TranscriptLinkSource @default(MANUAL)
  /// 从钉钉听记地址解析出的听记 ID；解析不到时为空，只能走人工录入降级
  minutesId   String?
  materials   InterviewTranscriptMaterial[]
  @@index([candidateId, jobId, round])
  @@index([minutesId])
  @@map("interview_transcript_links")
}

enum TranscriptLinkSource {
  MANUAL
  DINGTALK

  @@map("transcript_link_source")
}

/// 听记素材：原文/摘要按轮次留存，来源可追溯；同一链接重复读取同一素材不新增也不覆盖
model InterviewTranscriptMaterial {
  id           String   @id @default(cuid())
  linkId       String
  interviewId  String
  candidateId  String
  jobId        String
  round        Int
  source       TranscriptMaterialSource
  minutesId    String?
  title        String?
  summary      String?  @db.MediumText
  originalText String?  @db.MediumText
  /// 分段时间轴 [{index,startMs,endMs,speaker,text}]，供 INTERVIEW_EVAL evidence.sourceRef 回指原文
  segments     Json?
  /// 素材文本归一化后的 SHA-256：重复读取同一素材不新增，也不覆盖既有记录
  contentHash  String
  /// 来源标识（如 dingtalk-minutes:<minutesId>#<contentHash 前 12 位>），供评估依据回指
  sourceRef    String
  fetchedBy    String
  fetchedAt    DateTime @default(now())
  link         InterviewTranscriptLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, contentHash])
  @@index([interviewId, round])
  @@map("interview_transcript_materials")
}

enum TranscriptMaterialSource {
  DINGTALK
  MANUAL_ENTRY

  @@map("transcript_material_source")
}

model OfferRecord {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  jobId           String
  stage           OfferStage @default(MATERIAL_PENDING)
  /// 新工作流独立于旧原型值；空值表示历史记录待人工核对
  workflowStage   String?
  stageStatus     String?
  workflowVersion Int @default(0)
  hireLevel       String?
  salaryReturned  Boolean @default(false)
  writtenResult   OralResult?
  failureInitiator String?
  failureReasonType String?
  failureReasonLabel String?
  failureReasonText String? @db.Text
  oaApprovalId    String?
  /// 由系统发起的钉钉 OA 录用审批实例 ID；为空表示 OA 单号仍为人工回填
  oaInstanceId    String?
  /// 钉钉 OA 实例状态（NEW/RUNNING/COMPLETED/TERMINATED），仅展示，不驱动阶段结果
  oaInstanceStatus String?
  /// 钉钉 OA 实例结论（agree/refuse），仅展示，阶段结果仍由人事回填
  oaInstanceResult String?
  oaSyncedAt      DateTime?
  /// OA 单号来源：DINGTALK 表示系统发起并回写，MANUAL 表示人事手工填写
  oaSource        String?
  oralResult      OralResult?
  rejectReasonId  String?
  backgroundCheckStatus BgStatus @default(PENDING)
  materials       String? @db.Text
  onboardDate     DateTime?
  offerSentAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([oaInstanceId])
  @@map("offer_records")
}

/// 换职位或人才库回流时保留旧 Offer 的业务快照及材料归属。
model OfferRecordHistory {
  id          String @id @default(cuid())
  candidateId String
  jobId       String
  materials   String? @db.Text
  snapshot    Json
  recordedBy  String
  createdAt   DateTime @default(now())
  @@index([candidateId, jobId])
  @@map("offer_record_history")
}

enum OfferStage {
  MATERIAL_PENDING
  OA_PENDING
  SALARY_RETURNED
  NEGOTIATING
  ORAL_ACCEPTED
  ORAL_REJECTED
  BG_IN_PROGRESS
  BG_CONFIRMED
  BG_FAILED
  OFFER_TO_SEND
  OFFER_SENT

  @@map("offer_stage")
}

enum OralResult {
  ACCEPTED
  REJECTED

  @@map("oral_result")
}

enum BgStatus {
  PENDING
  CONFIRMED_OK
  CONFIRMED_FAILED

  @@map("bg_status")
}

model ProbationRecord {
  id          String   @id @default(cuid())
  candidateId String   @unique
  converted   Boolean  @default(false)
  convertedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("probation_records")
}

/// 人才库归档记录：每次归档一行，激活后追加 reactivatedAt/reactivatedJobId 保留全部历史（ATS-013）
model CandidateTalentPoolEntry {
  id                String   @id @default(cuid())
  candidateId       String
  archivedAt        DateTime
  sourceStage       String
  reasonId          String?
  /// 归档原因文本快照；归档时未填写（未填写档）为 null，并由 reasonMissing 区分
  reasonText        String?  @db.Text
  reasonMissing     Boolean  @default(false)
  reactivatedAt     DateTime?
  reactivatedJobId  String?
  reactivatedById   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, archivedAt])
  @@index([archivedAt])
  @@map("talent_pool_entries")
}

/// 原因选项（集 A 淘汰/归档、集 B Offer 拒绝、集 C 放弃入职）：稳定 ID，停用不删除以保留历史含义（ATS-024 补排序/版本）
model ReasonOption {
  id          String     @id @default(cuid())
  type        ReasonType
  label       String
  active      Boolean    @default(true)
  /// 同集合内升序展示
  sortOrder   Int        @default(0)
  /// 乐观锁版本：并发修改返回冲突而不是静默覆盖
  version     Int        @default(1)
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type, active, sortOrder])
  @@map("reason_options")
}

/// 通用字典（ATS-024）：职能类型、职级、需求类型、渠道、标签；停用不删除
model DictItem {
  id          String   @id @default(cuid())
  type        String
  label       String
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, label])
  @@index([type, active, sortOrder])
  @@map("dict_items")
}

/// 字段配置（ATS-024）：职位/需求/候选人字段的必填与显示；固定必填条件由服务端注册表强制，不可取消
model FieldConfig {
  id          String   @id @default(cuid())
  entity      String
  fieldKey    String
  required    Boolean  @default(false)
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entity, fieldKey])
  @@map("field_configs")
}

/// 面试方案（ATS-024）：轮次模板，职位通过 interviewPlanId 引用；停用后已有职位保持原引用
model InterviewPlan {
  id          String   @id @default(cuid())
  name        String
  rounds      Int
  description String?  @db.Text
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("interview_plans")
}

enum ReasonType {
  ARCHIVE
  OFFER_REJECT
  ONBOARD_ABANDON

  @@map("reason_type")
}

model AIRun {
  id          String   @id @default(cuid())
  type        AiRunType
  /// 输入引用为 JSON 文本，重试时追加 mockOutcome 等字段会超出 VARCHAR(191)
  inputRefs   String?  @db.Text
  output      String?  @db.Text
  status      AiRunStatus @default(PENDING)
  isDraft     Boolean  @default(true)
  confirmedBy String?
  confirmedAt DateTime?
  confidence  Json?
  attempts    Int      @default(0)
  errorCode   String?
  errorMessage String?
  /// INTERVIEW_EVAL 关联的面试轮次（ATS-020 素材交付）；简历类任务为空
  interviewId String?
  /// 实际执行的 provider 与模型（ATS-021：模型/成本/延迟/能力据实记录）
  providerName     String?
  modelName        String?
  templateVersion  String?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  costMicros       Int?
  /// 输出契约校验告警（只记录字段名与原因，不保存原文）
  validation  Json?
  /// 人工编辑留痕（AI-1：草稿可编辑后显式确认）
  editedBy    String?
  editedAt    DateTime?
  /// 同一评估目标的幂等键：避免重复点击产生重复调用与重复计费
  dedupeKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([interviewId, createdAt])
  @@index([type, createdAt])
  @@index([dedupeKey, status])
  @@map("ai_runs")
}

enum AiRunType {
  RESUME_PARSE
  RESUME_EVAL
  INTERVIEW_EVAL

  @@map("ai_run_type")
}

enum AiRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED

  @@map("ai_run_status")
}

model BrowserImportTask {
  id                String   @id @default(cuid())
  requestId         String
  operatorId        String
  sourceSite        String
  sourceCandidateId String?
  sourcePageUrl     String?
  /// 来源页面仅保留协议 + 主机，路径/查询串不落库（ATS-010 URL 脱敏）
  sourcePageHost    String?
  targetJobId       String?
  pagePayload       Json?
  resumeFileId      String?
  fileName          String?
  fileHash          String?
  status            BrowserImportStatus @default(RECEIVED)
  candidateId       String?
  errorCode         String?
  errorMessage      String?
  /// 失败阶段：VALIDATE / UPLOAD / PARSE / CONFIRM，便于任务审计定位（ATS-010）
  errorStage        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  completedAt       DateTime?

  @@unique([requestId, operatorId])
  @@index([operatorId])
  @@index([sourceSite, sourceCandidateId])

  @@map("browser_import_tasks")
}

enum BrowserImportStatus {
  RECEIVED
  PARSING
  SUCCESS
  DUPLICATE
  FAILED

  @@map("browser_import_status")
}

model TimelineEvent {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  actorId     String?
  action      String
  payload     Json?
  createdAt   DateTime @default(now())

  @@map("timeline_events")
}

/// 简历附件：按内容 SHA-256 去重，相同文件不重复占用存储（PRD §6.4）
model ResumeFile {
  id             String   @id @default(cuid())
  sha256         String   @unique
  fileName       String
  mimeType       String
  size           Int
  storageKey     String
  /// 写入时的存储驱动，便于迁移期间区分本地与 OSS 对象
  storageDriver  String   @default("local")
  /// 敏感材料分类：空为普通简历；背调/流水按独立授权访问（NFR-4）
  category       SensitiveField?
  /// 到期时间，由保留期限配置在写入时计算（NFR-2）
  expiresAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  intakes        ResumeIntake[]

  @@index([expiresAt])
  @@map("resume_files")
}

/// 入场记录：一次入场动作一条，承载来源/进入方式/查重/解析状态
model ResumeIntake {
  id                     String       @id @default(cuid())
  source                 String
  entryMode              String
  status                 IntakeStatus @default(RECEIVED)
  candidateId            String?
  createdById             String?
  createdBy               User?         @relation("IntakeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  jobId                  String?
  intentId               String?
  resumeFileId           String?
  airRunId               String?
  duplicateOfCandidateId String?
  mailFrom               String?
  mailSubject            String?
  /// 接收简历的招聘邮箱（邮箱渠道监控与筛选口径）
  mailboxAddress         String?
  /// 来源记录：推荐人/来源标识随入场保存，查重合并时写入来源台账（FR-REF-1～3）
  referrerName           String?
  referrerContact        String?
  referralCode           String?
  sourceNote             String?      @db.Text
  receivedAt             DateTime?
  attempts               Int          @default(0)
  errorCode              String?
  errorMessage           String?
  /// 查重合并时间：合并后来源与附件保留在本条入场记录上（FR-ENT-6）
  mergedAt               DateTime?
  mergedById             String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  resumeFile             ResumeFile?  @relation(fields: [resumeFileId], references: [id])

  @@index([status])
  @@index([entryMode])
  @@index([candidateId])
  @@index([createdById])
  @@index([jobId])
  @@index([mailFrom])
  @@index([mailboxAddress])
  @@index([referrerName])
  @@index([referralCode])
  @@map("resume_intakes")
}

/// 简历来源记录：每次入场保留一条，查重合并时把来源全部保留到原候选人（FR-REF-1～3）
model CandidateSourceRecord {
  id                    String   @id @default(cuid())
  candidateId           String
  /// 对应入场记录；一次入场最多一条来源记录
  intakeId              String?  @unique
  source                String
  entryMode             String?
  jobId                 String?
  /// 推荐人姓名或员工标识
  referrerName          String?
  /// 推荐人联系方式（工号/手机号/邮箱），仅用于来源追溯
  referrerContact       String?
  /// 来源标识（内推码、渠道活动码等）
  referralCode          String?
  note                  String?  @db.Text
  /// 查重合并时记录来源所属的重复候选人
  mergedFromCandidateId String?
  createdById           String?
  createdAt             DateTime @default(now())

  @@index([candidateId, createdAt])
  @@index([source])
  @@index([jobId])
  @@index([referrerName])
  @@index([referralCode])
  @@map("candidate_source_records")
}

/// 校招投递：虚拟职位统一入口 + 个人意愿表；人工分配正式职位后保留原始意愿（功能需求 §4.9）
model CampusApplication {
  id             String    @id @default(cuid())
  intakeId       String    @unique
  candidateId    String?
  /// 投递时选择的职位（虚拟职位或带正式职位投递）
  jobId          String?
  jobIsVirtual   Boolean   @default(false)
  /// 个人意愿表单（JSON 文本）：意向岗位、城市、毕业时间等
  preferences    String    @db.Text
  school         String?
  major          String?
  graduationYear String?
  expectedCity   String?
  availableFrom  DateTime?
  remark         String?   @db.Text
  /// SUBMITTED（已投递待分配）/ ASSIGNED（已人工分配正式职位）
  status         String    @default("SUBMITTED")
  assignedJobId  String?
  assignedAt     DateTime?
  assignedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([jobId])
  @@index([candidateId])
  @@index([assignedJobId])
  @@map("campus_applications")
}

/// Excel 批量导入批次：Excel 走独立表格导入，不进入 AI 解析管道（PRD §6.4）
model ExcelImportBatch {
  id            String           @id @default(cuid())
  fileName      String
  createdById   String?
  createdBy     User?            @relation("ExcelImportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  totalRows     Int              @default(0)
  successRows   Int              @default(0)
  duplicateRows Int              @default(0)
  failedRows    Int              @default(0)
  createdAt     DateTime         @default(now())
  rows          ExcelImportRow[]

  @@index([createdById])
  @@map("excel_import_batches")
}

/// Excel 行级结果：失败行可导出、可人工处理，不重复建档
model ExcelImportRow {
  id           String           @id @default(cuid())
  batchId      String
  batch        ExcelImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber    Int
  payload      Json?
  status       ExcelRowStatus   @default(FAILED)
  candidateId  String?
  intakeId     String?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime         @default(now())

  @@index([batchId, status])
  @@map("excel_import_rows")
}

enum ExcelRowStatus {
  SUCCESS
  DUPLICATE
  FAILED

  @@map("excel_row_status")
}

enum IntakeStatus {
  RECEIVED
  PARSING
  PARSED
  DUPLICATE
  NEEDS_MANUAL
  FAILED

  @@map("intake_status")
}

/// 接收简历邮箱配置：ATS-022 起支持真实 IMAP 轮询，凭据只存密文
model MailInboxConfig {
  id                  String    @id @default(cuid())
  address             String    @unique
  /// MOCK（历史模拟配置）/ IMAP（真实轮询）
  provider            String    @default("MOCK")
  active              Boolean   @default(true)
  host                String?
  port                Int?
  secure              Boolean   @default(true)
  username            String?
  /// AES-256-GCM 密文（iv.tag.cipher），接口不返回明文、不写日志
  secretCipher        String?   @db.Text
  folder              String    @default("INBOX")
  pollIntervalSeconds Int       @default(300)
  /// 增量游标：UIDVALIDITY 变化时必须重置游标，避免漏抓或重复建档
  lastUidValidity     String?
  lastUid             String?
  lastPolledAt        DateTime?
  /// OK / FAILED，供抓取状态与运行监控展示
  lastPollStatus      String?
  lastError           String?   @db.Text
  lastErrorAt         DateTime?
  consecutiveFailures Int       @default(0)
  lastFetchedCount    Int       @default(0)
  lastCreatedCount    Int       @default(0)
  lastDuplicateCount  Int       @default(0)
  lastSkippedCount    Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("mail_inbox_configs")
}

/// 邮件处理台账：每封已处理邮件一条，作为断点恢复幂等键与抓取监控口径（FR-ENT-1/8）
model MailMessageLog {
  id              String    @id @default(cuid())
  mailboxAddress  String
  /// 邮件 Message-ID；缺失时用正文 SHA-256 兜底，保证同一封邮件不重复建档
  messageId       String
  uid             String?
  subject         String?
  fromAddress     String?
  receivedAt      DateTime?
  /// INGESTED / DUPLICATE / NO_ATTACHMENT / UNSUPPORTED / EXCEL / ERROR
  outcome         String
  detail          String?   @db.Text
  attachmentCount Int       @default(0)
  intakeCount     Int       @default(0)
  createdAt       DateTime  @default(now())

  @@unique([mailboxAddress, messageId])
  @@index([mailboxAddress, createdAt])
  @@index([outcome])
  @@map("mail_message_logs")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum IdentityProvider {
  LOCAL
  DINGTALK

  @@map("identity_provider")
}

enum DataScope {
  SELF
  DEPARTMENT
  OWN_JOBS
  PARTICIPATING
  DEPARTMENT_AND_PARTICIPATING
  ALL

  @@map("data_scope")
}

enum SensitiveField {
  CANDIDATE_CONTACT
  BACKGROUND_MATERIALS
  BANK_STATEMENTS

  @@map("sensitive_field")
}

enum AuditOutcome {
  SUCCESS
  DENIED

  @@map("audit_outcome")
}

model Department {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  isActive  Boolean      @default(true)
  parentId  String?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentTree")
  users     User[]
  memberships UserDepartment[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([parentId])
  @@map("departments")
}

model User {
  id                 String             @id @default(cuid())
  employeeNo         String?            @unique
  displayName        String
  /// Contact email; duplicates are allowed and must not be used as an identity key.
  email              String?
  status             UserStatus         @default(ACTIVE)
  departmentId       String?
  department         Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentMemberships UserDepartment[]
  identityLinks      IdentityLink[]
  roleAssignments    UserRole[]
  groupMemberships   UserGroupMember[]
  fieldGrants         FieldAccessGrant[] @relation("FieldGrantUser")
  issuedFieldGrants   FieldAccessGrant[] @relation("FieldGrantIssuer")
  refreshSessions     RefreshSession[]
  createdCandidates   Candidate[]        @relation("CandidateCreator")
  departmentScreenings CandidateDepartmentScreening[]
  savedCandidateFilters SavedCandidateFilter[]
  createdIntakes      ResumeIntake[]      @relation("IntakeCreator")
  excelImportBatches  ExcelImportBatch[]  @relation("ExcelImportCreator")
  auditLogs           AuditLog[]          @relation("AuditActor")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([departmentId, status])
  @@map("users")
}

/// 钉钉用户可属于多个部门；departmentId 仍保留为主部门以兼容现有业务。
model UserDepartment {
  userId       String
  departmentId String
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId, userId])
  @@map("user_departments")
}

model IdentityLink {
  id         String           @id @default(cuid())
  provider   IdentityProvider
  subject    String
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedAt DateTime?
  createdAt  DateTime         @default(now())

  @@unique([provider, subject])
  @@unique([provider, userId])
  @@index([userId])
  @@map("identity_links")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  dataScope   DataScope        @default(SELF)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId        String
  roleId        String
  scopeOverride DataScope?
  assignedById  String?
  assignedAt    DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserGroup {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String?
  members     UserGroupMember[]
  fieldGrants FieldAccessGrant[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("user_groups")
}

model UserGroupMember {
  userId    String
  groupId   String
  addedAt   DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_group_members")
}

model FieldAccessGrant {
  id          String         @id @default(cuid())
  field       SensitiveField
  canRead     Boolean        @default(false)
  canWrite    Boolean        @default(false)
  userId      String?
  userGroupId String?
  grantedById String?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  user        User?          @relation("FieldGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  userGroup   UserGroup?     @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  grantedBy   User?          @relation("FieldGrantIssuer", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([field, userId, expiresAt])
  @@index([field, userGroupId, expiresAt])
  @@map("field_access_grants")
}

model RefreshSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  familyId   String
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@map("refresh_sessions")
}

model AuditLog {
  id             String       @id @default(cuid())
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  requestId      String
  beforeSummary  Json?
  afterSummary   Json?
  ip             String?
  userAgent      String?
  outcome        AuditOutcome @default(SUCCESS)
  createdAt      DateTime     @default(now())
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model DingTalkSyncEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  subjectId   String?
  corpId      String
  status      String    @default("RECEIVED")
  attempts    Int       @default(0)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  lastError   String?

  @@index([status, receivedAt])
  @@map("dingtalk_sync_events")
}

/// 短期系统令牌：浏览器扩展等系统调用方使用，只存哈希，过期或吊销即失效（ATS-010）
model SystemToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  /// 令牌代表的操作者，导入任务按此归属并做所有者校验
  operatorId String
  purpose    String
  issuedById String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([operatorId])
  @@index([expiresAt])
  @@map("system_tokens")
}

/// 附件与结构化记录的到期清理批次（NFR-2；保留期限配置化，具体天数上线前确认）
model RetentionRun {
  id              String   @id @default(cuid())
  scope           String
  cutoff          DateTime
  scanned         Int      @default(0)
  expired         Int      @default(0)
  deletedFiles    Int      @default(0)
  detachedIntakes Int      @default(0)
  failedDeletes   Int      @default(0)
  dryRun          Boolean  @default(false)
  actorId         String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("retention_runs")
}

/// 保温提醒投递到内部人事收件箱；钉钉发送由 ATS-018 适配。
model OnboardingReminder {
  id            String   @id @default(cuid())
  candidateId   String
  jobId         String
  recipientId   String
  onboardDate   DateTime
  dueAt         DateTime
  createdAt     DateTime @default(now())
  readAt        DateTime?

  @@unique([candidateId, recipientId, onboardDate, dueAt], map: "onboarding_reminder_dedupe")
  @@index([recipientId, createdAt])
  @@map("onboarding_reminders")
}

/// 固定事件的工作通知出站记录；UNKNOWN 表示发送结果不明，禁止自动重复发送。
model NotificationDelivery {
  id          String    @id @default(cuid())
  eventKey    String
  sourceKey   String
  recipientId String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  dueAt       DateTime
  nextRetryAt DateTime?
  startedAt   DateTime?
  sentAt      DateTime?
  taskId      String?
  platformRecipient String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([eventKey, sourceKey, recipientId], map: "notification_delivery_dedupe")
  @@index([status, dueAt, nextRetryAt])
  @@index([recipientId, createdAt])
  @@map("notification_deliveries")
}

/// 面试与钉钉日程的一对一持久同步状态。
model InterviewCalendarSync {
  interviewId       String    @id
  organizerId       String
  organizerUnionId  String?
  createToken       String
  eventId           String?
  desiredVersion    Int       @default(1)
  claimedVersion    Int?
  appliedVersion    Int       @default(0)
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  nextRetryAt       DateTime?
  startedAt         DateTime?
  checkedAt         DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@map("interview_calendar_sync")
}
