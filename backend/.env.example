# 应用（本地开发示例；生产环境通过部署密钥注入真实值）
APP_ENV=local
APP_PORT=3000
JWT_ACCESS_SECRET=local-only-replace-with-a-random-secret-at-least-32-bytes
REFRESH_TOKEN_PEPPER=local-only-replace-with-a-random-pepper-at-least-32-bytes
TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=14
INITIAL_ADMIN_SECRET=
LOCAL_AUTH_ENABLED=true
# 本地专用账号；仅当 APP_ENV=local 且启用 LOCAL_AUTH_ENABLED 时由种子脚本创建。
LOCAL_ADMIN_IDENTIFIER=admin
LOCAL_AUTH_SECRET=admin

# 数据库 / 队列
DATABASE_URL=mysql://root:replace-me@127.0.0.1:3306/talentflow
REDIS_URL=redis://127.0.0.1:6379

# 钉钉（仅在授权测试企业注入真实值；禁止把令牌或密钥提交到仓库）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
# OAuth2 回调完整 URL，须与钉钉开放平台配置一致；生产必须 HTTPS
DINGTALK_REDIRECT_URI=http://localhost:3000/api/v1/auth/dingtalk/callback
DINGTALK_LOGIN_SUCCESS_REDIRECT=http://localhost:4173/?dingtalk_login=success
# 事件订阅地址：${API_PUBLIC_BASE_URL}/api/v1/dingtalk/events
DINGTALK_CALLBACK_TOKEN=
DINGTALK_CALLBACK_AES_KEY=
# 默认使用 DINGTALK_CLIENT_ID（AppKey）；仅当回调配置明确要求其他 ownerKey 时覆盖
DINGTALK_CALLBACK_OWNER_KEY=
DINGTALK_ROOT_DEPARTMENT_NAME=企业根部门
DINGTALK_SYNC_MAX_ATTEMPTS=5
DINGTALK_SYNC_RETRY_DELAY_MS=1000
# 仅在确认通讯录读取范围覆盖全组织后启用缺失成员/部门停用
DINGTALK_SYNC_DEACTIVATE_MISSING=false

# 文件存储（开发环境本地磁盘；测试/生产使用阿里云 OSS 私有 Bucket）
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
RESUME_MAX_MB=20
# 签名读链接有效期（秒，取值区间 30-3600）
SIGNED_URL_TTL_SECONDS=300
# 签名密钥：非 local 环境必须显式提供，禁止复用 JWT 密钥
STORAGE_SIGNING_SECRET=
# 签名链接的对外 API 地址（本地默认 http://127.0.0.1:${APP_PORT}）
API_BASE_URL=
# 阿里云 OSS（STORAGE_DRIVER=oss 时必填；Bucket 必须为私有）
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_INTERNAL=false
OSS_SECURE=true

# 附件保留期限（天）：具体数值上线前与业务确认（NFR-2）
RETENTION_RESUME_DAYS=365
RETENTION_SENSITIVE_DAYS=180
RETENTION_BATCH_SIZE=200

# AI（本期 Mock）
AI_PROVIDER=mock

# 解析队列
PARSE_MAX_ATTEMPTS=3
PARSE_RETRY_DELAY_MS=1000
QUEUE_CONCURRENCY=2
