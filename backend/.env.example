# 应用（本地开发示例；生产环境通过部署密钥注入真实值）
APP_ENV=local
APP_PORT=3000
JWT_ACCESS_SECRET=local-only-replace-with-a-random-secret-at-least-32-bytes
REFRESH_TOKEN_PEPPER=local-only-replace-with-a-random-pepper-at-least-32-bytes
TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=14
INITIAL_ADMIN_SECRET=
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_SECRET=

# 数据库 / 队列
DATABASE_URL=mysql://root:replace-me@127.0.0.1:3306/talentflow
REDIS_URL=redis://127.0.0.1:6379

# 文件存储（开发环境本地磁盘；测试/生产使用阿里云 OSS 私有 Bucket）
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
RESUME_MAX_MB=20
# 签名读链接有效期（秒，取值区间 30-3600）
SIGNED_URL_TTL_SECONDS=300
# 签名密钥：非 local 环境必须显式提供，禁止复用 JWT 密钥
STORAGE_SIGNING_SECRET=
# 签名链接的对外 API 地址（本地默认 http://127.0.0.1:${APP_PORT}）
API_BASE_URL=
# 阿里云 OSS（STORAGE_DRIVER=oss 时必填；Bucket 必须为私有）
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_INTERNAL=false
OSS_SECURE=true

# 附件保留期限（天）：具体数值上线前与业务确认（NFR-2）
RETENTION_RESUME_DAYS=365
RETENTION_SENSITIVE_DAYS=180
RETENTION_BATCH_SIZE=200

# AI（本期 Mock）
AI_PROVIDER=mock

# 解析队列
PARSE_MAX_ATTEMPTS=3
PARSE_RETRY_DELAY_MS=1000
QUEUE_CONCURRENCY=2
