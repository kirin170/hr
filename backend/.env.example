# 应用
APP_ENV=local
APP_PORT=3000

# 数据库 / 队列
DATABASE_URL=mysql://root:password@127.0.0.1:3306/talentflow
REDIS_URL=redis://127.0.0.1:6379

# 文件存储（开发环境本地磁盘）
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
RESUME_MAX_MB=20

# AI（本期 Mock）
AI_PROVIDER=mock

# 解析队列
PARSE_MAX_ATTEMPTS=3
PARSE_RETRY_DELAY_MS=1000
QUEUE_CONCURRENCY=2
